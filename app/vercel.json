{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "ignoreCommand": "[ \"$VERCEL_ENV\" != production ]",
  "github": { "silent": true },
  "rewrites": [
    {
      "source": "/auth/:yol*",
      "destination": "https://ep-tiny-glitter-b1158ps1.neonauth.c-5.eu-central-1.aws.neon.tech/neondb/auth/:yol*"
    },
    {
      "source": "/rest/:yol*",
      "destination": "https://ep-tiny-glitter-b1158ps1.apirest.c-5.eu-central-1.aws.neon.tech/neondb/rest/v1/:yol*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
